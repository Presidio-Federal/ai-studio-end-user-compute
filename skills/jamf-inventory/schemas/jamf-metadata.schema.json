{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jamf-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "updated_at",
    "source_agent",
    "evidence_ref",
    "last_visit_id",
    "last_collected_at",
    "baseline_ref",
    "status",
    "coverage",
    "delta",
    "computers",
    "live_id",
    "subjective",
    "objective",
    "assessment",
    "plan"
  ],
  "properties": {
    "keys": { "type": "array", "maxItems": 0 },
    "schema": { "const": "jamf-metadata/v1" },
    "updated_at": { "type": "string", "minLength": 20 },
    "source_agent": { "const": "jamf-inventory" },
    "evidence_ref": { "type": ["string", "null"] },
    "last_visit_id": { "type": ["string", "null"] },
    "last_collected_at": { "type": ["string", "null"] },
    "baseline_ref": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "degraded", "unknown"] },
    "coverage": { "enum": ["complete", "partial", "unavailable"] },
    "delta": { "enum": ["first", "unchanged", "changed", "unread"] },
    "computers": { "type": "integer", "minimum": 0 },
    "live_id": { "type": ["string", "null"] },
    "subjective": { "type": "string", "maxLength": 400 },
    "objective": { "type": "string", "maxLength": 400 },
    "assessment": { "type": "string", "maxLength": 400 },
    "plan": { "type": "string", "maxLength": 400 }
  }
}
