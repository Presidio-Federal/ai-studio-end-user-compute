{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickets-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "updated_at",
    "source_agent",
    "evidence_ref",
    "last_visit_id",
    "last_collected_at",
    "baseline_ref",
    "status",
    "coverage",
    "delta",
    "devices",
    "number",
    "state",
    "issue",
    "subjective",
    "objective",
    "assessment",
    "plan"
  ],
  "properties": {
    "keys": { "type": "array", "maxItems": 0 },
    "schema": { "const": "tickets-metadata/v1" },
    "updated_at": { "type": "string", "minLength": 20 },
    "source_agent": { "const": "ticket" },
    "evidence_ref": { "type": ["string", "null"] },
    "last_visit_id": { "type": ["string", "null"] },
    "last_collected_at": { "type": ["string", "null"] },
    "baseline_ref": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "degraded", "unknown"] },
    "coverage": { "enum": ["complete", "partial", "unavailable"] },
    "delta": { "enum": ["first", "unchanged", "changed", "unread"] },
    "devices": { "type": "integer", "minimum": 0 },
    "number": { "type": ["string", "null"], "maxLength": 40 },
    "state": { "type": ["string", "null"], "maxLength": 40 },
    "issue": { "type": ["string", "null"], "maxLength": 40 },
    "subjective": { "type": "string", "maxLength": 400 },
    "objective": { "type": "string", "maxLength": 400 },
    "assessment": { "type": "string", "maxLength": 400 },
    "plan": { "type": "string", "maxLength": 400 }
  }
}
