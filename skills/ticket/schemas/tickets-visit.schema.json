{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tickets-visit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "coverage",
    "baseline_ref",
    "vs_prior",
    "devices",
    "unchanged",
    "removed",
    "notes",
    "scope"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" }
    },
    "schema": { "const": "tickets/v1" },
    "source": { "const": "tickets" },
    "watch_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
    "checked_at": { "type": "string", "minLength": 20 },
    "ok": { "type": "boolean" },
    "status": { "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "maxLength": 400 },
    "coverage": { "enum": ["complete", "partial"] },
    "baseline_ref": { "type": ["string", "null"], "pattern": "^tickets/[0-9]{4}-.+$" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" }
    },
    "unchanged": { "type": "integer", "minimum": 0 },
    "removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/removed" }
    },
    "notes": { "type": "string", "maxLength": 200 },
    "scope": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "pattern": "^(device|site|warehouse|request):[^ ].*$"
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": { "enum": ["first", "changed"] },
        "changed": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "field", "prior", "current"],
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "prior": { "type": "string" },
              "current": { "type": "string" }
            }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "id",
        "name",
        "serial",
        "user",
        "number",
        "sys_id",
        "state",
        "short_description",
        "source_ref",
        "asset_tag",
        "cmdb_ci",
        "created",
        "note"
      ],
      "properties": {
        "keys": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "number": { "type": ["string", "null"], "maxLength": 40 },
        "sys_id": { "type": ["string", "null"], "maxLength": 40 },
        "state": { "type": ["string", "null"], "maxLength": 40 },
        "short_description": { "type": ["string", "null"], "maxLength": 160 },
        "source_ref": { "type": ["string", "null"] },
        "asset_tag": { "type": ["string", "null"], "maxLength": 80 },
        "cmdb_ci": { "type": ["string", "null"], "maxLength": 40 },
        "created": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serial", "keys"],
      "properties": {
        "id": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
      }
    }
  }
}
