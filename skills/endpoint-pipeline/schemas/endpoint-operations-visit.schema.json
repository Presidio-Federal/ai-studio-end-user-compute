{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "endpoint-operations-visit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "coverage",
    "baseline_ref",
    "vs_prior",
    "devices",
    "unchanged",
    "written",
    "failed",
    "notes",
    "scope"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" }
    },
    "schema": { "const": "endpoint-operations/v1" },
    "source": { "const": "endpoint-operations" },
    "watch_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
    "checked_at": { "type": "string", "minLength": 20 },
    "ok": { "type": "boolean" },
    "status": { "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "maxLength": 400 },
    "coverage": { "enum": ["complete", "partial"] },
    "baseline_ref": { "type": ["string", "null"] },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" }
    },
    "unchanged": { "type": "integer", "minimum": 0 },
    "written": { "type": "integer", "minimum": 0 },
    "failed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string", "maxLength": 200 },
    "scope": { "type": ["string", "null"] }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "pattern": "^(device|site|warehouse|request):[^ ].*$"
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": { "enum": ["first", "changed"] },
        "changed": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "field", "prior", "current"],
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "prior": { "type": "string" },
              "current": { "type": "string" }
            }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "serial", "request", "sources", "note"],
      "properties": {
        "keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/tag" }
        },
        "serial": { "type": "string", "minLength": 1 },
        "request": { "type": "string", "minLength": 1 },
        "site": { "type": ["string", "null"] },
        "warehouse": { "type": ["string", "null"] },
        "hostname": { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "last_check_in": { "type": ["string", "null"] },
        "management_state": { "enum": ["managed", "unmanaged", null] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ServiceNow", "Jamf", "Intune", "Nexthink"] }
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
