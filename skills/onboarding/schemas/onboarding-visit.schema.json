{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding-visit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "coverage",
    "baseline_ref",
    "vs_prior",
    "devices",
    "unchanged",
    "removed",
    "notes",
    "scope"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" }
    },
    "schema": { "const": "onboarding/v1" },
    "source": { "const": "onboarding" },
    "watch_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
    "checked_at": { "type": "string", "minLength": 20 },
    "ok": { "type": "boolean" },
    "status": { "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "maxLength": 400 },
    "coverage": { "enum": ["complete", "partial"] },
    "baseline_ref": { "type": ["string", "null"], "pattern": "^onboarding/[0-9]{4}-.+$" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "devices": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/device" }
    },
    "unchanged": { "type": "integer", "minimum": 0 },
    "removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/removed" }
    },
    "notes": { "type": "string", "maxLength": 200 },
    "scope": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "pattern": "^(device|site|warehouse|request):[^ ].*$"
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": { "enum": ["first", "changed"] },
        "changed": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "field", "prior", "current"],
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "prior": { "type": "string" },
              "current": { "type": "string" }
            }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "id",
        "name",
        "serial",
        "user",
        "jamf_id",
        "jamf_enrolled",
        "jamf_managed",
        "prestage_id",
        "prestage_name",
        "entra_id",
        "join_type",
        "intune_id",
        "intune_managed",
        "stage",
        "sources",
        "note"
      ],
      "properties": {
        "keys": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "jamf_id": { "type": ["string", "null"] },
        "jamf_enrolled": { "type": ["boolean", "null"] },
        "jamf_managed": { "type": ["boolean", "null"] },
        "prestage_id": { "type": ["string", "null"] },
        "prestage_name": { "type": ["string", "null"] },
        "entra_id": { "type": ["string", "null"] },
        "join_type": { "type": ["string", "null"] },
        "intune_id": { "type": ["string", "null"] },
        "intune_managed": { "type": ["boolean", "null"] },
        "stage": {
          "enum": ["not_seen", "prestage", "enrolled", "directory", "managed", "unknown"]
        },
        "sources": {
          "type": "array",
          "items": { "enum": ["mdm", "directory"] }
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serial", "keys"],
      "properties": {
        "id": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
      }
    }
  }
}
