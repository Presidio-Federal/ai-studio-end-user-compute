{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investigations-visit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "coverage",
    "baseline_ref",
    "vs_prior",
    "devices",
    "unchanged",
    "removed",
    "notes",
    "scope"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" }
    },
    "schema": { "const": "investigations/v1" },
    "source": { "const": "investigations" },
    "watch_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
    "checked_at": { "type": "string", "minLength": 20 },
    "ok": { "type": "boolean" },
    "status": { "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "maxLength": 400 },
    "coverage": { "enum": ["complete", "partial"] },
    "baseline_ref": { "type": ["string", "null"], "pattern": "^investigations/[0-9]{4}-.+$" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" }
    },
    "unchanged": { "type": "integer", "minimum": 0 },
    "removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/removed" }
    },
    "notes": { "type": "string", "maxLength": 200 },
    "scope": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "pattern": "^(device|site|warehouse|request):[^ ].*$"
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": { "enum": ["first", "changed"] },
        "changed": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "field", "prior", "current"],
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "prior": { "type": "string" },
              "current": { "type": "string" }
            }
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "value": { "type": "string", "maxLength": 80 }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "id",
        "name",
        "serial",
        "user",
        "jamf_id",
        "managed",
        "supervised",
        "user_approved_mdm",
        "mdm_capable",
        "collector_uid",
        "platform",
        "last_seen",
        "lookup",
        "matches",
        "issue",
        "crash_count",
        "top_process",
        "signals",
        "note"
      ],
      "properties": {
        "keys": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "jamf_id": { "type": ["string", "null"] },
        "managed": { "type": ["boolean", "null"] },
        "supervised": { "type": ["boolean", "null"] },
        "user_approved_mdm": { "type": ["boolean", "null"] },
        "mdm_capable": { "type": ["boolean", "null"] },
        "collector_uid": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "last_seen": { "type": ["string", "null"] },
        "lookup": { "enum": ["serial", "name", "user"] },
        "matches": { "type": "integer", "minimum": 0 },
        "issue": {
          "enum": [
            "application_crashes",
            "experience_recorded",
            "experience_unread",
            "not_in_nexthink",
            "not_in_jamf",
            "no_signal",
            "unknown"
          ]
        },
        "crash_count": { "type": ["integer", "null"], "minimum": 0 },
        "top_process": { "type": ["string", "null"] },
        "signals": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/signal" }
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serial", "keys"],
      "properties": {
        "id": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
      }
    }
  }
}
